# Server
PORT=3001

# Persistent data directory — set this to your Railway volume mount path in production
# e.g. DATA_DIR=/data   (leave blank for local dev, defaults to ./data)
DATA_DIR=

# Optional: set to "true" to trigger a scrape immediately on startup
SCRAPE_ON_START=true

# CORS — set to your frontend URL in production (your Railway/Vercel frontend URL)
FRONTEND_URL=http://localhost:5173

# How many days back to accept job postings
MAX_DAYS_OLD=7

# Max jobs to return per API response
MAX_JOBS=20

# Google Gemini API key for resume tailoring (required for /api/tailor)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# JSearch API key — replaces fragile LinkedIn/Indeed HTML scrapers
# Free tier: 500 requests/month — https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# If not set, falls back to direct HTML scrapers (less reliable)
JSEARCH_API_KEY=your_jsearch_api_key_here
